    --accent-secondary: #aaaaaa;
    --accent-tertiary: #999999;
    --accent-green: #4ade80;
    --accent-orange: #fbbf24;
    --accent-red: #f87171;
    --accent-pink: #f472b6;

    --gradient-main: linear-gradient(135deg, #888888, #aaaaaa);
    --gradient-purple: linear-gradient(135deg, #999999, #888888);
    --gradient-warm: linear-gradient(135deg, #aaaaaa, #888888);
    --gradient-glow: linear-gradient(135deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02));
    --gradient-card-top: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);

    --shadow-sm: 0 2px 8px rgba(0,0,0,0.5);
    --shadow-md: 0 4px 20px rgba(0,0,0,0.6);
    --shadow-lg: 0 8px 40px rgba(0,0,0,0.7);
    --shadow-glow: 0 0 30px rgba(255,255,255,0.03);
    --shadow-glow-secondary: 0 0 30px rgba(255,255,255,0.02);

    --particle-color: 200, 200, 200;
    --particle-glow: 180, 180, 180;
    --particle-line: 180, 180, 180;
    --aurora1: rgba(255,255,255,0.03);
    --aurora2: rgba(255,255,255,0.02);
    --aurora3: rgba(255,255,255,0.01);
    --orb1: rgba(255,255,255,0.03);
    --orb2: rgba(255,255,255,0.02);
    --orb3: rgba(255,255,255,0.01);
    --sidebar-bg: rgba(8, 8, 8, 0.98);
    --sidebar-accent: rgba(255,255,255,0.06);
    --sidebar-accent-hover: rgba(255,255,255,0.03);
    --sidebar-icon-bg: rgba(255,255,255,0.04);
    --sidebar-icon-active: rgba(255,255,255,0.08);
    --sidebar-icon-hover: rgba(255,255,255,0.06);
    --formula-bg: rgba(4, 4, 4, 0.9);
    --paso-bg: rgba(12, 12, 12, 0.8);
    --paso-bg-hover: rgba(18, 18, 18, 0.9);
    --graph-bg: #050505;
    --scrollbar-color: rgba(255, 255, 255, 0.1);
    --scrollbar-hover: rgba(255, 255, 255, 0.2);

    --input-bg: rgba(35, 35, 35, 0.85);
    --input-border: rgba(160, 160, 160, 0.3);
    --input-border-focus: #888;
    --input-text: #e0e0e0;
    --input-placeholder: rgba(140, 140, 140, 0.5);

    --loader-accent: #888;
    --loader-accent2: #bbb;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    overflow: hidden;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg-primary);
    color: var(--text-primary);
    height: 100vh;
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* ========================
   EPIC LOADING SCREEN
   ======================== */
#loading-screen {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: #050204;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.8s ease, visibility 0.8s ease;
}

#loading-screen.fade-out {
    opacity: 0;
    visibility: hidden;
}

.loader-bg-symbols {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
}

.loader-bg-symbol {
    position: absolute;
    color: rgba(220, 38, 38, 0.06);
    font-family: 'JetBrains Mono', monospace;
    animation: loaderSymbolFloat linear infinite;
    user-select: none;
    pointer-events: none;
}

@keyframes loaderSymbolFloat {
    0% {
        transform: translateY(110vh) rotate(0deg) scale(0.7);
        opacity: 0;
    }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% {
        transform: translateY(-10vh) rotate(360deg) scale(1.2);
        opacity: 0;
    }
}

.loader-content {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
}

.loader-logo {
    position: relative;
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
}

.loader-integral {
    font-size: 4rem;
    font-weight: 900;
    background: linear-gradient(135deg, var(--loader-accent), var(--loader-accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    z-index: 2;
    position: relative;
    animation: loaderIntegralPulse 2s ease-in-out infinite;
}

@keyframes loaderIntegralPulse {
    0%, 100% { transform: scale(1); filter: drop-shadow(0 0 20px rgba(220,38,38,0.4)); }
    50% { transform: scale(1.08); filter: drop-shadow(0 0 40px rgba(220,38,38,0.7)); }
}

.loader-ring {
    position: absolute;
    inset: 0;
    animation: loaderRingSpin 3s linear infinite;
}

.loader-ring svg {
    width: 100%;
    height: 100%;
}

.loader-ring-bg {
    fill: none;
    stroke: rgba(220, 38, 38, 0.08);
    stroke-width: 2;
}

.loader-ring-fill {
    fill: none;
    stroke: url(#loaderGradient);
    stroke-width: 3;
    stroke-dasharray: 326;
    stroke-dashoffset: 326;
    stroke-linecap: round;
    animation: loaderRingDash 2s ease-in-out infinite;
}

@keyframes loaderRingSpin {
    to { transform: rotate(360deg); }
}

@keyframes loaderRingDash {
    0% { stroke-dashoffset: 326; }
    50% { stroke-dashoffset: 80; }
    100% { stroke-dashoffset: 326; }
}

.loader-title {
    font-size: 2.4rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, var(--loader-accent), var(--loader-accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: loaderTitleGlow 2s ease-in-out infinite alternate;
}

@keyframes loaderTitleGlow {
    0% { filter: drop-shadow(0 0 10px rgba(220,38,38,0.3)); }
    100% { filter: drop-shadow(0 0 25px rgba(220,38,38,0.6)); }
}

.loader-subtitle {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(255,255,255,0.4);
    margin-top: -8px;
}

.loader-progress-bar {
    width: 220px;
    height: 3px;
    background: rgba(255,255,255,0.06);
    border-radius: 10px;
    overflow: hidden;
    margin-top: 12px;
}

.loader-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--loader-accent), var(--loader-accent2));
    border-radius: 10px;
    transition: width 0.3s ease;
    box-shadow: 0 0 10px var(--loader-accent);
}

.loader-formula {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    color: rgba(255,255,255,0.25);
    margin-top: 8px;
    transition: opacity 0.3s ease;
    min-height: 1.4em;
}

/* ========================
   CANVAS PARTICLES
   ======================== */
#particle-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
}

/* Animated Background Orbs */
.bg-animation {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
}

.bg-animation::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at 30% 40%, var(--orb1) 0%, transparent 50%),
                radial-gradient(circle at 70% 60%, var(--orb2) 0%, transparent 50%),
                radial-gradient(circle at 50% 80%, var(--orb3) 0%, transparent 50%);
    animation: bgFloat 20s ease-in-out infinite;
}

@keyframes bgFloat {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    33% { transform: translate(2%, -2%) rotate(1deg); }
    66% { transform: translate(-1%, 1%) rotate(-0.5deg); }
}

/* ========================
   AURORA EFFECT
   ======================== */
.aurora-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
}

.aurora {
    position: absolute;
    width: 150%;
    height: 60%;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
    mix-blend-mode: screen;
}

.aurora-1 {
    top: -30%;
    left: -20%;
    background: radial-gradient(ellipse, var(--aurora1), transparent 70%);
    animation: auroraMove1 25s ease-in-out infinite;
}

.aurora-2 {
    top: 10%;
    right: -30%;
    background: radial-gradient(ellipse, var(--aurora2), transparent 70%);
    animation: auroraMove2 30s ease-in-out infinite;
}

.aurora-3 {
    bottom: -20%;
    left: 10%;
    background: radial-gradient(ellipse, var(--aurora3), transparent 70%);
    animation: auroraMove3 22s ease-in-out infinite;
}

@keyframes auroraMove1 {
    0%, 100% { transform: translate(0, 0) scale(1) rotate(0deg); }
    25% { transform: translate(5%, 8%) scale(1.1) rotate(5deg); }
    50% { transform: translate(-3%, 4%) scale(0.95) rotate(-3deg); }
    75% { transform: translate(2%, -5%) scale(1.05) rotate(2deg); }
}

@keyframes auroraMove2 {
    0%, 100% { transform: translate(0, 0) scale(1) rotate(0deg); }
    30% { transform: translate(-8%, -5%) scale(1.15) rotate(-4deg); }
    60% { transform: translate(4%, 6%) scale(0.9) rotate(3deg); }
}

@keyframes auroraMove3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    40% { transform: translate(6%, -8%) scale(1.1); }
    70% { transform: translate(-4%, 3%) scale(0.95); }
}

/* ========================
   FLOATING MATH SYMBOLS
   ======================== */
.math-particles {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
}

.math-particle {
    position: absolute;
    color: var(--text-muted);
    opacity: 0.2;
    animation: floatUp linear infinite;
    font-family: 'JetBrains Mono', monospace;
    user-select: none;
    pointer-events: none;
}

@keyframes floatUp {
    0% {
        transform: translateY(100vh) rotate(0deg) scale(0.8);
        opacity: 0;
    }
    8% { opacity: 0.25; }
    50% { opacity: 0.18; }
    92% { opacity: 0.25; }
    100% {
        transform: translateY(-10vh) rotate(360deg) scale(1.1);
        opacity: 0;
    }
}

/* ========================
   MOUSE FOLLOWER
   ======================== */
.mouse-follower {
    position: fixed;
    width: 350px;
    height: 350px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    transform: translate(-50%, -50%);
    transition: left 0.15s ease-out, top 0.15s ease-out;
    background: radial-gradient(circle, rgba(var(--particle-glow), 0.04) 0%, transparent 70%);
}

/* Layout - Scrollable */
.contenedor-principal {
    display: flex;
    height: 100vh;
    position: relative;
    z-index: 1;
    overflow: hidden;
}

.panel-central {
    flex: 1;
    padding: 40px 50px;
    overflow-y: auto;
    overflow-x: hidden;
    height: 100vh;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
}

/* Custom Scrollbar */
.panel-central::-webkit-scrollbar {
    width: 6px;
}

.panel-central::-webkit-scrollbar-track {
    background: transparent;
}

.panel-central::-webkit-scrollbar-thumb {
    background: var(--scrollbar-color);
    border-radius: 10px;
}

.panel-central::-webkit-scrollbar-thumb:hover {
    background: var(--scrollbar-hover);
}

/* Header */
.header-panel {
    text-align: center;
    margin-bottom: 40px;
    animation: fadeSlideDown 0.6s ease-out;
}

.header-panel h2 {
    font-size: 2.8rem;
    font-weight: 800;
    margin-bottom: 12px;
    background: var(--gradient-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.02em;
    line-height: 1.2;
}

.header-panel p {
    color: var(--text-secondary);
    font-size: 1.05rem;
    font-weight: 400;
}

/* Cards */
.card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: 32px;
    margin-bottom: 28px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: var(--shadow-md);
    transition: var(--transition-normal);
    position: relative;
    overflow: hidden;
}

.card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--gradient-card-top);
    opacity: 0;
    transition: var(--transition-normal);
}

.card:hover::before {
    opacity: 1;
}

.card:hover {
    border-color: var(--border-glow);
    box-shadow: var(--shadow-glow);
}

.card-header {
    margin-bottom: 28px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.card-header-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--gradient-glow);
    border: 1px solid var(--border-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
}

.card-header h3 {
    color: var(--text-accent);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
}

/* Animations */
@keyframes fadeSlideDown {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

@keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
}

@keyframes scaleIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
}

/* Radius Variables */
:root {
    --radius-sm: 8px;
    --radius-md: 14px;
    --radius-lg: 20px;
    --radius-xl: 28px;
    --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-normal: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-smooth: 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Modal Overlay */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(8px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.2s ease-out;
}

.modal-overlay.active {
    display: flex;
}

.modal-content {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: 36px;
    max-width: 600px;
    width: 90%;
    max-height: 80vh;
    overflow-y: auto;
    backdrop-filter: blur(30px);
    box-shadow: var(--shadow-lg);
    animation: scaleIn 0.3s ease-out;
}

.modal-content h2 {
    background: var(--gradient-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 20px;
    font-size: 1.6rem;
    font-weight: 800;
}

.modal-content h3 {
    color: var(--text-accent);
    margin: 18px 0 8px;
    font-size: 1.1rem;
    font-weight: 700;
}

.modal-content p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.7;
    margin-bottom: 12px;
}

.modal-content ul {
    padding-left: 20px;
    margin-bottom: 12px;
}

.modal-content li {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 4px;
}

.modal-close {
    display: block;
    margin: 20px auto 0;
    padding: 12px 32px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-glow);
    background: var(--sidebar-accent);
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition-fast);
}

.modal-close:hover {
    background: var(--bg-card-hover);
    box-shadow: var(--shadow-glow);
}

/* Responsive */
@media (max-width: 900px) {
    .contenedor-principal {
        flex-direction: column;
    }
    .panel-central {
        padding: 20px;
        height: auto;
        max-height: calc(100vh - 60px);
    }
    .header-panel h2 {
        font-size: 2rem;
    }
}
