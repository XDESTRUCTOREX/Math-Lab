from backend.modelos.exactas import resolver_exactas

exactas_bp = Blueprint("exactas", __name__)

@exactas_bp.route("/resolver/exactas", methods=["POST"])
def resolver():
    try:
        datos = request.get_json()
        if not datos:
            return jsonify({
